# 反诈大屏 · 环境变量示例（复制为 .env.local 覆盖本地配置）
# 所有 VITE_ 前缀变量会在构建期内联进前端 bundle，请勿放入真实密钥

# 设备接口基础地址（必填，http(s):// 开头的完整 URL）
VITE_API_BASE_URL=https://smart-agent.work/apps/catdevice

# SSE 日志端点（可选；留空则由 VITE_API_BASE_URL + VITE_SSE_PATH_SUFFIX 派生）
VITE_SSE_URL=

# 设备接口路径前缀（必填）
VITE_API_PREFIX=/api/v1/devices

# SSE 路径后缀（必填，VITE_SSE_URL 为空时派生用）
VITE_SSE_PATH_SUFFIX=/api/logs

# 截图轮询间隔（毫秒，正整数）
VITE_SCREENSHOT_INTERVAL=150

# 默认运行模式 mock | real
VITE_DEFAULT_MODE=mock

# 预留鉴权 Token（可选，当前未启用）
VITE_API_TOKEN=
